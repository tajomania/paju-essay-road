{
  "name": "essay-road",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/worker.js && node --check src/teacher-ai.js && node --check src/gemini.js && node --check local/server.mjs && node --check public/app.js",
    "local:start": "node local/server.mjs",
    "local:package": "node scripts/package-local.mjs"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
